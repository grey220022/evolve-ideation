# GitHub OAuth App (create at https://github.com/settings/developers;
# set the callback URL to http://localhost:3000/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Zhipu open platform API key (https://open.bigmodel.cn)
GLM_API_KEY=

# GLM endpoint (default: coding plan via the Anthropic-compatible endpoint;
# for pay-as-you-go keys use https://open.bigmodel.cn/api/paas/v4)
GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic

# Model name (full list: GET {GLM_BASE_URL}/v1/models)
GLM_MODEL=glm-4.6

# Review rounds: 1 = single-pass quick review; >1 = multi-round deep dive
# (each round carries the full conversation history)
ANALYSIS_ROUNDS=1
